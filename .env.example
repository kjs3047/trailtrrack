# TrailTrack environment configuration.
# Copy this file to `.env` and fill in real values.
# `.env` is loaded as a Flutter asset at runtime (see lib/core/config/app_config.dart)
# and is git-ignored so secrets are never committed.

# Cesium ion access token (https://ion.cesium.com/tokens).
# Required for Cesium World Terrain and ion imagery.
# If empty, the map falls back to terrain-less / open imagery where possible.
CESIUM_ION_TOKEN=

# Whether the Google Drive backup/restore UI is shown.
GOOGLE_DRIVE_ENABLED=true

# Google Drive sign-in (google_sign_in 7.x) REQUIRES a Web OAuth client ID as
# serverClientId on Android. Create BOTH an Android OAuth client (package
# com.trailtrack.trailtrack + your signing SHA-1) AND a Web OAuth client in the
# same Google Cloud project, then paste the WEB client id here.
# Without it, Drive save/load shows a setup message (no crash). See
# GOOGLE_DRIVE_BACKUP.md.
GOOGLE_DRIVE_SERVER_CLIENT_ID=
